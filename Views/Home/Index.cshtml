@using pi.Enums
@model List<ProdutoHomeViewModel>;

@{
    ViewData["Title"] = "MicroConnect - Seja bem-vindo(a)";
    int index = 1;
    string classe = "a";
    Safras safraAtual;
    var hoje = DateTime.Now;
    int data = hoje.Month * 100 + hoje.Day;
    switch (data)
    {
        case >= 1221 or < 320:
            safraAtual = Safras.Verao;
            break;
        case >= 320 and < 621:
            safraAtual = Safras.Outono;
            break;
        case >= 621 and < 923:
            safraAtual = Safras.Inverno;
            break;
        default:
            safraAtual = Safras.Primavera;
            break;
    }
}

<header class="slideshow">
    <div>
        <img class="headerImage active" src="./assets/images/foto_destaque3.jpeg" alt="Imagem Destaque 3">
        <img class="headerImage" src="./assets/images/foto_destaque1.jpg" alt="Imagem Destaque 1">
        <img class="headerImage" src="./assets/images/foto_destaque2.jpeg" alt="Imagem Destaque 2">
    </div>

    
</header>

<div class="banner">
    <div class="buttonsHighlights">

        <button class="ballButton selected"></button>
        <button class="ballButton"></button>
        <button class="ballButton"></button>

    </div>
    <div class="btns">
        <a asp-controller="Auth" asp-action="RegisterCliente" class="RCButton">Seja Cliente</a>
        <a asp-controller="Auth" asp-action="RegisterProdutor" class="RPButton">Torne-se Produtor</a>
    </div>
</div>

<h2 class="title">Destaques de @safraAtual</h2>

@if (!Model.Any(item => item.Produto.Safra == safraAtual))
{
    <p class="noRegister">Não há nenhum produto cadastrado no momento.</p>
}

<div class="lista">
    @foreach (var item in Model)
    {
        
        if (item.Produto.Safra == safraAtual)
        {
            index++;
            classe = index % 2 == 0 ? "a" : "b";
            <div class="produto">
                <button type="button" class="@classe produto-toggle listadestaques" aria-expanded="false">
                    @item.Produto.Nome
                    <img class="arrows" src="~/assets/icons/seta_baixo.svg"></img>
                </button>
                <div class="produtores" hidden>
                    <table>
                        <thead>
                            <th>Nome</th>
                            <th>Quantidade</th>
                        </thead>
                        <tbody>
                            @foreach (var rel in item.Produtores)
                            {
                                
                                <tr>
                                    <td>@(rel.Produtor?.Nome ?? "Produtor indisponível")</td>
                                        
                                    <td>@rel.Quantidade</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

<a class="seeMore">VER MAIS</a>

@section Scripts {
    <script src="~/js/slideshow.js"></script>
}

<script>

    document.querySelectorAll(".produto-toggle").forEach(botao => {
        const seta = botao.querySelector("img");
        botao.addEventListener("click", () => {
            const lista = botao.nextElementSibling;
            const aberto = !lista.hidden;
            seta.src = !aberto ? "./assets/icons/seta_cima.svg" : "./assets/icons/seta_baixo.svg";
            lista.hidden = aberto;
            botao.setAttribute("aria-expanded", String(!aberto));
        });
    });
</script>