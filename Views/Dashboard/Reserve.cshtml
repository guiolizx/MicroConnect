@model ClienteModel;

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Dashboard";
}





<h2 id="ds" style="position:relative; top:-70px;">ÁREA DO CLIENTE</h2>

<div class="panel" style="top:-70px; height:400px;">
    <div class="toppanel">
        <div class="left">
            <div class="campo">
                <h3>Cliente</h3>
                <h2 id="username">@Model.Nome</h2>
            </div>
            <div class="campo">
                <h3>CPF</h3>
                <h2 id="cpf">@Model.Cpf</h2>
            </div>
            <div class="campo-horizontal">
                <div class="campo">
                    <h4>Email:</h4>
                    <h5 id="email">@Model.Email</h5>
                </div>
                <div class="campo">
                    <h4>Senha:</h4>
                    <h5 id="senha">***********</h5>
                </div>
            </div>
        </div>
        <div class="right">
            <a class="registerButton">ALTERAR DADOS</a>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.9/jquery.inputmask.min.js"></script>

<script>
    Inputmask("999.999.999-99", {
        removeMaskOnSubmit: true
    }).mask("#cpf");
</script>