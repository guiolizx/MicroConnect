@{
    ViewData["Title"] = "MicroConnect - Login";
}
<h1 class="title">Faça seu login</h1>
<form class="form">
    <div class="label">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="Digite seu e-mail cadastrado" required>
    </div>
    <div class="label">
        <label for="password">Senha</label>
        <input type="password" id="password" name="password" placeholder="Digite sua senha" required>
    </div>

    <div class="loginArea">
    <p class="resetPassword"><a href="/resetPassword.html">Esqueci minha senha</a></p>
    <button class="registerButton">Entrar</button>
    </div>
</form>
