@model RegisterProdutorViewModel

@{
    Layout = null;
    ViewData["Title"] = "MicroConnect - Cadastrar Produtor";
}
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap');
</style>

<link rel="stylesheet" href="~/css/variables.css">
<link rel="stylesheet" href="~/css/nav.css">
<link rel="stylesheet" href="~/css/style.css">
<h1 class="title">Cadastre-se Produtor</h1>

<form class="form" asp-controller="Auth" asp-action="EditarProdutor" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Senha" />
    <div class="inp">
        <label for="name">Nome</label>
        <input type="text" id="name" placeholder="Digite seu nome" asp-for="Nome">
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="inp">
        <label for="cnpj">CNPJ</label>
        <input type="text" id="CNPJ" placeholder="Digite seu CNPJ" asp-for="Cnpj">
        <span asp-validation-for="Cnpj" class="text-danger"></span>
    </div>
    <div class="twoColumns">
        <div class="inp">
            <label for="email">Telefone</label>
            <input type="text" id="tel" placeholder="Digite seu telefone principal" asp-for="Telefone">
            <span asp-validation-for="Telefone" class="text-danger"></span>
        </div>
        <div class="inp">
            <label for="password">Endereco</label>
            <input type="text" id="endereco" placeholder="Digite seu endereco" asp-for="Endereco">
            <span asp-validation-for="Endereco" class="text-danger"></span>
        </div>
    </div>
    <div class="twoColumns">
        <div class="inp">
            <label for="email">Email</label>
            <input type="email" id="email" placeholder="Digite seu e-mail principal" asp-for="Email">
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>


    <button style="width:auto; position: relative; left: 0;" class="saveButton" type="submit">SALVAR</button>
    <a style="width:auto; position: relative; left: 0;" class="delButton" asp-controller="Auth" asp-action="DeleteProdutor">EXCLUIR</a>
    <a style="width:auto; position: relative; left: 0;" asp-controller="Dashboard" asp-action="Dashboard" class="backButton">VOLTAR</a>

</form>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.9/jquery.inputmask.min.js"></script>


<script>
    Inputmask("**.***.***/****-99", {
        definitions: {
            '*': {
                validator: "[A-Za-z0-9]"
            }
        },
        removeMaskOnSubmit: true
    }).mask("#CNPJ");

    Inputmask("99 99999-9999", {
        removeMaskOnSubmit: true
    }).mask("#tel");
</script>
