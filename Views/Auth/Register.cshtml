@{
    ViewData["Title"] = "MicroConnect - Cadastrar";
}

<h1 class="title">Cadastre-se</h1>

<form class="form">
    <div class="label">
        <label for="name">Nome</label>
        <input type="text" id="name" name="name" placeholder="Digite seu nome" required>
    </div>
    <div class="label">
        <label for="cnpj">CPF/CNPJ</label>
        <input type="text" id="cnpj" name="cnpj" placeholder="Digite seu CPF ou CNPJ" required>
    </div>
    <div class="twoColumns">
        <div class="label">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="Digite seu e-mail principal" required>
        </div>
        <div class="label">
            <label for="password">Senha</label>
            <input type="password" id="password" name="password" placeholder="******" required>
        </div>
    </div>

    <div class="loginArea">
    <p class="textLogin">Já tem conta? <a href="/login.html">Login</a></p>
    <button class="registerButton">Cadastrar</button>
    </div>
</form>